{
  "name": "poker-solver-console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:types && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "biome check --write src && tsc -b",
    "ci": "npm run gen:types && biome ci src && tsc -b && vitest run",
    "knip": "knip",
    "gen:types": "openapi-typescript src/api/openapi.json -o src/api/types.gen.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.95.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "knip": "^5.41.0",
    "openapi-typescript": "^7.4.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
