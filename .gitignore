downloads/
eggs/
.eggs/
# ANCHORED. These are setuptools' root-level build artifacts, but a bare `lib/`
# matches a directory of that name at ANY depth -- it was silently excluding
# `console/src/lib/`, three files the app imports, so a fresh clone would have
# failed to build with no hint why.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
.venv
venv/
ENV/
env/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.tox/
.hypothesis/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

